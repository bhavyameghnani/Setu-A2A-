# Copy to .env. Never commit .env.
# Local Postgres 16 (brew install postgresql@16) or a hosted instance such as Neon.
DATABASE_URL=postgresql+asyncpg://localhost:5432/setu
LOG_LEVEL=INFO
APP_ENV=dev
# Signing key for login tokens. Required unless APP_ENV=dev (dev uses an insecure placeholder).
# Generate one: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_TTL_MINUTES=60

# Key that encrypts stored agent credentials at rest (a Fernet key). Required unless APP_ENV=dev.
#   python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# Base URL that agents use to reach Setu's A2A facade (cards point here). Default: the request URL.
# PUBLIC_URL=https://setu.example.com

# --- OpenAI (LLM agents in examples/llm_agents); set the key in .env only ---
OPENAI_API_KEY=
CMF_OPENAI_MODEL=gpt-4o-mini
CMF_OPENAI_BASE_URL=https://api.openai.com/v1

# Ed25519 seed for signed artifacts (32 bytes, base64url). Required outside APP_ENV=dev.
#   python -c "import base64,os;print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
SIGNING_KEY=
